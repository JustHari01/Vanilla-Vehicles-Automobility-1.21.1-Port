{
  "format_version": "1.10.0",
  "animation_controllers": {
    "controller.animation.bw_vv.vehicle.engine": {
      "states": {
        "default": {
          "transitions": [
            { "standby": "query.property('bw_vv:fuel_progress')>0" }
          ]
        },
        "standby": {
          "animations": ["engine_sound.standby"],
          "transitions": [
            { "default": "query.property('bw_vv:fuel_progress')==0" },
            { "go": "query.has_player_rider && query.ground_speed > 3" }
          ]
        },
        "go": {
          "animations": ["engine_sound","engine_sound.close"],
          "transitions": [
            { "default": "query.property('bw_vv:fuel_progress')==0" },
            { "standby": "query.ground_speed < 3" }
          ]
        }
      }
    }
  }
}
