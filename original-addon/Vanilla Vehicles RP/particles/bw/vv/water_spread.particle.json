{
	"format_version": "1.10.0",
	"particle_effect": {
		"description": {
			"identifier": "bw_vv:water_spread",
			"basic_render_parameters": {
				"material": "particles_alpha",
				"texture": "textures/bw/vv/particle/water_spread"
			}
		},
		"components": {
			"minecraft:emitter_initialization": {
				"creation_expression": "variable.size = 0.08;variable.radius = 0.6;"
			},
			"minecraft:emitter_rate_steady": {
				"spawn_rate": "math.random(5,6)",
				"max_particles": 60
			},
			"minecraft:emitter_lifetime_looping": {
				"active_time": 1
			},
			"minecraft:emitter_shape_box": {
				"offset": ["math.cos(variable.particle_random_2*360) * 1.5", 0.07, "math.sin(variable.particle_random_2*360) * 1.5"],
				"surface_only": true,
				"direction": "outwards"
			},
			"minecraft:particle_lifetime_expression": {
				"max_lifetime": 1
			},
			"minecraft:particle_initial_speed": 0,
			"minecraft:particle_motion_dynamic": {},
			"minecraft:particle_appearance_billboard": {
				"size": ["1+variable.particle_random_2*0.2", "1+variable.particle_random_2*0.2"],
				"facing_camera_mode": "emitter_transform_xz",
				"uv": {
					"texture_width": 32,
					"texture_height": 256,
					"flipbook": {
						"base_UV": [0, 0],
						"size_UV": [32, 32],
						"step_UV": [0, 32],
						"max_frame": 8,
						"stretch_to_lifetime": true
					}
				}
			},
			"minecraft:particle_appearance_lighting": {},
			"minecraft:particle_appearance_tinting": {
				"color": [1, 1, 1, 1]
			}
		}
	}
}