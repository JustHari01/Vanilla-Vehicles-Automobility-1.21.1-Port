{
	"format_version": "1.10.0",
	"particle_effect": {
		"description": {
			"identifier": "bw_vv:water_foam.back",
			"basic_render_parameters": {
				"material": "particles_alpha",
				"texture": "textures/bw/vv/particle/water_foam"
			}
		},
		"components": {
			"minecraft:emitter_initialization": {
				"creation_expression": "variable.size = 0.08;variable.radius = 0.6;"
			},
			"minecraft:emitter_rate_steady": {
				"spawn_rate": 20,
				"max_particles": 60
			},
			"minecraft:emitter_lifetime_looping": {
				"active_time": 1
			},
			"minecraft:emitter_shape_point": {
				"offset": ["math.round((variable.particle_random_1-variable.particle_random_4)*20)/16", "-0.6+v.particle_random_2/2", "math.round((variable.particle_random_2-variable.particle_random_3)*20)/16"]
			},
			"minecraft:particle_lifetime_expression": {
				"max_lifetime": "math.random(0.5,1.2)"
			},
			"minecraft:particle_initial_speed": 0,
			"minecraft:particle_motion_dynamic": {},
			"minecraft:particle_appearance_billboard": {
				"size": ["v.particle_random_1*0.5+0.4", "v.particle_random_1*0.5+0.4"],
				"facing_camera_mode": "rotate_xyz",
				"uv": {
					"texture_width": 20,
					"texture_height": 120,
					"flipbook": {
						"base_UV": [0, 0],
						"size_UV": [20, 20],
						"step_UV": [0, 20],
						"max_frame": 8,
						"stretch_to_lifetime": true
					}
				}
			},
			"minecraft:particle_appearance_lighting": {},
			"minecraft:particle_appearance_tinting": {
				"color": [1, 1, 1, 1]
			}
		}
	}
}