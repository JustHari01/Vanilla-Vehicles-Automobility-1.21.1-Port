{
	"format_version": "1.10.0",
	"particle_effect": {
		"description": {
			"identifier": "bw_vv:redstone_sparks",
			"basic_render_parameters": {
				"material": "particles_alpha",
				"texture": "textures/bw/vv/particle/redstone_sparks"
			}
		},
		"components": {
			"minecraft:emitter_rate_steady": {
				"spawn_rate": 200,
				"max_particles": 100
			},
			"minecraft:emitter_lifetime_once": {
				"active_time": 0.1
			},
			"minecraft:emitter_shape_box": {
				"offset": [0, -0.3, 0],
				"half_dimensions": [0.2, 0.2, 0.2],
				"direction": ["math.random(-10,10)", -8, "math.random(-10,10)"]
			},
			"minecraft:particle_lifetime_expression": {
				"max_lifetime": "0.3+variable.particle_random_1*2"
			},
			"minecraft:particle_initial_speed": 5,
			"minecraft:particle_motion_dynamic": {
				"linear_acceleration": [0, -17, 0],
				"linear_drag_coefficient": 0.2
			},
			"minecraft:particle_appearance_billboard": {
				"size": ["(0.2+0.2*variable.particle_random_1)/4", "(0.1+0.05*variable.particle_random_1)/4"],
				"facing_camera_mode": "lookat_direction",
				"uv": {
					"texture_width": 22,
					"texture_height": 190,
					"flipbook": {
						"base_UV": [13, 13],
						"size_UV": [2, 1],
						"step_UV": [0, 19],
						"frames_per_second": 32,
						"max_frame": 8,
						"stretch_to_lifetime": true
					}
				}
			},
			"minecraft:particle_motion_collision": {
				"collision_drag": 30,
				"collision_radius": 0.3
			},
			"minecraft:particle_appearance_tinting": {
				"color": {
					"interpolant": "v.particle_age / v.particle_lifetime",
					"gradient": {
						"0.0": "#FFFFFFFF",
						"0.23": "#FFFFFFFF",
						"0.34": "#FFE11B1B"
					}
				}
			}
		}
	}
}