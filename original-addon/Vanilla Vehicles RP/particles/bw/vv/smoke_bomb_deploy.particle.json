{
	"format_version": "1.10.0",
	"particle_effect": {
		"description": {
			"identifier": "bw_vv:smoke_bomb_deploy",
			"basic_render_parameters": {
				"material": "particles_alpha",
				"texture": "textures/particle/particles"
			}
		},
		"components": {
			"minecraft:emitter_rate_steady": {
				"spawn_rate": 50,
				"max_particles": 100
			},
			"minecraft:emitter_lifetime_once": {
				"active_time": 2.75
			},
			"minecraft:emitter_shape_point": {
				"direction": [0, 0, "math.random(-6, 6)"]
			},
			"minecraft:particle_lifetime_expression": {
				"max_lifetime": 1
			},
			"minecraft:particle_initial_speed": "math.random(6, 7)",
			"minecraft:particle_motion_dynamic": {
				"linear_acceleration": ["math.random(-6, 6)", 0, "math.random(-6, 6)"],
				"linear_drag_coefficient": "(variable.particle_random_3*3)+4"
			},
			"minecraft:particle_appearance_billboard": {
				"size": ["math.sin(variable.particle_age*250)*0.2+(variable.particle_random_1*0.1)", "math.sin(variable.particle_age*250)*0.2+(variable.particle_random_1*0.1)"],
				"facing_camera_mode": "rotate_xyz",
				"uv": {
					"texture_width": 128,
					"texture_height": 128,
					"flipbook": {
						"base_UV": [40, 0],
						"size_UV": [8, 8],
						"step_UV": [-8, 0],
						"frames_per_second": 6,
						"max_frame": 8,
						"stretch_to_lifetime": true
					}
				}
			},
			"minecraft:particle_motion_collision": {
				"collision_radius": 0.1
			},
			"minecraft:particle_appearance_lighting": {},
			"minecraft:particle_appearance_tinting": {
				"color": {
					"interpolant": "v.particle_age / v.particle_lifetime",
					"gradient": {
						"0.0": "#ffffffff",
						"1.0": "#ff000000"
					}
				}
			}
		}
	}
}