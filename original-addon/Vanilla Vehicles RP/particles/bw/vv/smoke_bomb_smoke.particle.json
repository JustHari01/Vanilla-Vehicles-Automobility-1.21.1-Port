{
	"format_version": "1.10.0",
	"particle_effect": {
		"description": {
			"identifier": "bw_vv:smoke_bomb_smoke",
			"basic_render_parameters": {
				"material": "particles_alpha",
				"texture": "textures/bw/vv/particle/smoke_bomb"
			}
		},
		"components": {
			"minecraft:emitter_rate_steady": {
				"spawn_rate": 20,
				"max_particles": 120
			},
			"minecraft:emitter_lifetime_once": {
				"active_time": 8
			},
			"minecraft:emitter_shape_point": {
				"direction": ["math.random(-1.4, 1)", -0.5, "math.random(-1, 1)"]
			},
			"minecraft:particle_lifetime_expression": {
				"max_lifetime": "math.random(4, 13)"
			},
			"minecraft:particle_initial_speed": "3+ v.particle_random_1*3",
			"minecraft:particle_motion_dynamic": {
				"linear_acceleration": [0, "math.random(-2, 2)", 0],
				"linear_drag_coefficient": 0.9
			},
			"minecraft:particle_appearance_billboard": {
				"size": ["1.0 + v.particle_random_1", "1.0 + v.particle_random_1"],
				"facing_camera_mode": "rotate_xyz",
				"uv": {
					"texture_width": 32,
					"texture_height": 448,
					"flipbook": {
						"base_UV": [0, 0],
						"size_UV": [32, 32],
						"step_UV": [0, 32],
						"frames_per_second": 2,
						"max_frame": 14,
						"stretch_to_lifetime": true
					}
				}
			},
			"minecraft:particle_motion_collision": {
				"collision_drag": 0.9,
				"coefficient_of_restitution": 0.1,
				"collision_radius": 0.01
			},
			"minecraft:particle_appearance_lighting": {},
			"minecraft:particle_appearance_tinting": {
				"color": ["v.particle_color_r", "v.particle_color_g", "v.particle_color_b", 0.2]
			}
		}
	}
}