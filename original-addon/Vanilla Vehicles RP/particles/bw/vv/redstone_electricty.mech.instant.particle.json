{
	"format_version": "1.10.0",
	"particle_effect": {
		"description": {
			"identifier": "bw_vv:redstone_electricty.mech.instant",
			"basic_render_parameters": {
				"material": "particles_blend",
				"texture": "textures/bw/vv/particle/redstone_electricity_explosion"
			}
		},
		"components": {
			"minecraft:emitter_initialization": {
				"creation_expression": "variable.size = 0.4;variable.radius = 1;"
			},
			"minecraft:emitter_local_space": {
				"position": true,
				"rotation": false
			},
			"minecraft:emitter_rate_steady": {
				"spawn_rate": 30,
				"max_particles": 100
			},
			"minecraft:emitter_lifetime_once": {
				"active_time": 0.3
			},
			"minecraft:emitter_shape_point": {
				"offset": ["math.random(-v.radius,v.radius)", "math.random(-v.radius,v.radius)", "math.random(-v.radius,v.radius)"]
			},
			"minecraft:particle_lifetime_expression": {
				"max_lifetime": 0.4
			},
			"minecraft:particle_initial_speed": 0,
			"minecraft:particle_motion_dynamic": {},
			"minecraft:particle_motion_parametric": {
				"rotation": "v.particle_random_1*360"
			},
			"minecraft:particle_appearance_billboard": {
				"size": ["variable.size+v.particle_random_1*0.3", "variable.size+v.particle_random_1*0.3"],
				"facing_camera_mode": "rotate_xyz",
				"uv": {
					"texture_width": 16,
					"texture_height": 144,
					"flipbook": {
						"base_UV": [0, 0],
						"size_UV": [16, 16],
						"step_UV": [0, 16],
						"frames_per_second": 2,
						"max_frame": 10,
						"stretch_to_lifetime": true
					}
				}
			},
			"minecraft:particle_appearance_tinting": {
				"color": [1, 1, 1, "query.camera_distance_range_lerp(1,3)"]
			}
		}
	}
}