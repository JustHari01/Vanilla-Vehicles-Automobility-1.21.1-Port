{
	"format_version": "1.10.0",
	"particle_effect": {
		"description": {
			"identifier": "bw_vv:smoke_big",
			"basic_render_parameters": {
				"material": "particles_blend",
				"texture": "textures/bw/vv/particle/smoke_big"
			}
		},
		"components": {
			"minecraft:emitter_rate_instant": {
				"num_particles": "6*variable.mob_size"
			},
			"minecraft:emitter_lifetime_once": {
				"active_time": 1
			},
			"minecraft:emitter_shape_entity_aabb": {
				"direction": "outwards"
			},
			"minecraft:particle_lifetime_expression": {
				"max_lifetime": "Math.random(0.7,1.8)"
			},
			"minecraft:particle_initial_speed": 11,
			"minecraft:particle_motion_dynamic": {
				"linear_acceleration": [0, 3, 0],
				"linear_drag_coefficient": 13
			},
			"minecraft:particle_appearance_billboard": {
				"size": ["(variable.particle_random_1*0.6+0.3)*variable.mob_size", "(variable.particle_random_1*0.6+0.3)*variable.mob_size"],
				"facing_camera_mode": "rotate_xyz",
				"uv": {
					"texture_width": 16,
					"texture_height": 128,
					"flipbook": {
						"base_UV": [0, 0],
						"size_UV": [16, 16],
						"step_UV": [0, 16],
						"frames_per_second": 12,
						"max_frame": 8,
						"stretch_to_lifetime": true
					}
				}
			},
			"minecraft:particle_motion_collision": {
				"enabled": "true",
				"collision_drag": 0.9,
				"collision_radius": 0.01
			},
			"minecraft:particle_appearance_lighting": {},
			"minecraft:particle_appearance_tinting": {
				"color": {
					"interpolant": "v.particle_age / v.particle_lifetime",
					"gradient": {
						"0.0": "#C4B9B5AF",
						"1.0": "#1CB5B2AD"
					}
				}
			}
		}
	}
}