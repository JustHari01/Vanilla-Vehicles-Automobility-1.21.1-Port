        { "bundle1*": "q.property('bw_vv:chested')" },
        { "bundle2*": "q.property('bw_vv:chested')" },
        { "bundle3*": "q.property('bw_vv:chested')" },
        { "bundle4*": "q.property('bw_vv:chested')" },
        { "bundle5*": "q.property('bw_vv:chested')" },
        { "bundle6*": "q.property('bw_vv:chested')" },
        { "bundle7*": "q.property('bw_vv:chested')" },
        { "bundle8*": "q.property('bw_vv:chested')" }
      ],
      "geometry": "Geometry.default",
      "materials": [
           { "*": "Material.default" },
           { "balloon1": "Material.changecolor" },
		   { "balloon2": "Material.changecolor" }
