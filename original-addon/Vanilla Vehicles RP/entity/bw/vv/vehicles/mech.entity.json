{
  "format_version": "1.21.120",
  "minecraft:client_entity": {
    "description": {
      "identifier": "bw_vv:mech",
      "animations": {
        //SPAWN
        "spawn": "animation.bw_vv.mech_spawn",
        "spawn_controller": "controller.animation.bw_vv.mech_spawn",
        //MOVEMENT
        "walk.forward": "animation.bw_vv.mech_walk_forward",
        "walk.backward": "animation.bw_vv.mech_walk_backward",
        "walk.left": "animation.bw_vv.mech_walk_left",
        "walk.right": "animation.bw_vv.mech_walk_right",
        "jump": "animation.bw_vv.mech_jump",
        "boost": "animation.bw_vv.mech_boost",
        "land": "animation.bw_vv.mech_land",
        "walk_anim_timer": "animation.bw_vv.mech_walk_anim_timer",
        "move_controller": "controller.animation.bw_vv.mech_walk",
        "wasd_detector_controller": "controller.animation.bw_vv.mech_walk_wasd",
        "jump_controller": "controller.animation.bw_vv.mech_jump",
        //WEAPONS
        "weapons_off": "animation.bw_vv.mech_weapons_off",
        "weaponL": "animation.bw_vv.mech_weaponL",
        "weapons_controller": "controller.animation.bw_vv.mech_weapons",
        "aimL": "animation.bw_vv.mech_arms_aim_L",
        //HIT
        "hit_L": "animation.bw_vv.vehicle.hit.L",
        "hit_R": "animation.bw_vv.vehicle.hit.R",
        "hit_weak_L": "animation.bw_vv.vehicle.hit.weak.L",
        "hit_weak_R": "animation.bw_vv.vehicle.hit.weak.R",
        "hit_final": "animation.bw_vv.vehicle.hit.final",
        "hit_controller": "controller.animation.bw_vv.vehicle.hit",
        "boost_indicator": "animation.bw_vv.mech_boost_indicator"
      },
      "materials": {
        "default": "changecolor_vanillavehicles",
        "alpha_vanillavehiclesaddon": "alpha_vanillavehicles",
        "glow_vanillavehiclesaddon": "glow_vanillavehicles",
        "alpha_transparent_vanillavehiclesaddon": "alpha_transparency_vanillavehicles",
        "glow_masked_animated": "glow_vanillavehicles_masked_animated"
      },
      "scripts": {
        "scale": "q.property('bw_vv:removed') ? 0 : 1",
        "animate": [
          "move_controller",
          "jump_controller",
          "boost_indicator",
          "weapons_controller",
          "spawn_controller",
          "hit_controller",
          "weapons_off"
        ],
        "initialize": [
          "v.walk_timer = 0;",
          "v.spawned = 0;", //used for not repeating the animation_controller of the mech SPAWN animation.bw_vv.
          "v.hit_intensity = 1;",
          "v.hit_ratio_weak = 0;",
          "v.hit_ratio_tools = 0;",
          "v.sticker = 0;",
          "v.weapons = 0;",
          "v.boost_cooldown = 7;",
          "v.boost_cooldown_current = q.property('bw_vv:boost_cooldown');",
          "v.charge_cooldown = 3;",
          "v.charge_cooldown_current = q.property('bw_vv:weapons_cooldown');"
        ],
        "pre_animation": [
          // Spawn controller variables
          "v.spawned=q.property('bw_vv:spawned');",
          // Hit controller variables
          "v.hit_intensity = 0.1+1/(query.property('bw_vv:damage_weak') ? v.hit_ratio_weak*2 : v.hit_ratio_tools*2);",
          "v.hit_ratio_weak = (query.property('bw_vv:hit_resistance'))/query.property('bw_vv:damage_progress');",
          "v.hit_ratio_tools = (query.property('bw_vv:hit_resistance_tools')-2)/query.property('bw_vv:damage_progress');",
          // WASD detection variables
          "v.wasd = q.property('bw_vv:wasd');",
          // First person vertical movement of the cabin attenuation when jump animation is played
          "v.first_person_anim_modifier = query.camera_distance_range_lerp(4, 5);",
          // Weapons variables
          "variable.x_player_pre = query.has_player_rider ? (query.rider_body_x_rotation(0) - query.body_x_rotation) : 0;",
          "variable.y_player_pre = query.has_player_rider ? (query.rider_body_y_rotation(0) - query.body_y_rotation) : 0;",
          //----
          "variable.x_player_raw = math.mod(variable.x_player_pre,360);",
          "(variable.x_player_raw > 180) ? (variable.x_player_raw = variable.x_player_raw - 360);",
          "(variable.x_player_raw < -180) ? (variable.x_player_raw = variable.x_player_raw + 360);",
          //-----
          "variable.y_player_raw = math.mod(variable.y_player_pre,360);",
          "(variable.y_player_raw > 180) ? (variable.y_player_raw = variable.y_player_raw - 360);",
          "(variable.y_player_raw < -180) ? (variable.y_player_raw = variable.y_player_raw + 360);",

          "t.x_player = math.clamp(v.x_player_raw,-80,90);",
          "t.y_player = 0.8*math.clamp(v.y_player_raw,-20, 70);",
          "v.weapons = q.property('bw_vv:weapons');",

          "v.boost_cooldown = 7;",
          "v.boost_cooldown_current = q.property('bw_vv:boost_cooldown');",
          "v.charge_cooldown = 3;",
          "v.charge_cooldown_current = q.property('bw_vv:weapons_cooldown');"
        ]
      },
      "render_controllers": [
        "controller.render.bw_vv_mech",
        "controller.render.bw_vv_mech_animated"
      ],
      "textures": {
        "default": "textures/bw/vv/vehicles/mech/mech",
        "fueled": "textures/bw/vv/vehicles/mech/animated",
        "empty": "textures/bw/vv/empty"
      },
      "sound_effects": {
        "mech_spawn": "bw_vv.vehicle.mech.spawn",
        "step": "bw_vv.vehicle.mech.step",
        "weapon": "bw_vv.vehicle.mech.weapon",
        "land": "bw_vv.vehicle.mech.land"
      },
      "particle_effects": {
        "step_effect": "bw_vv:smoke.mech",
        "blast_effect": "bw_vv:redstone_trail.mech",
        "blast_effect2": "bw_vv:redstone_trail_2.mech",
        "redstone_explosion": "bw_vv:redstone_explosion",
        "redstone_electricity_explosion": "bw_vv:redstone_electricty.mech",
        "redstone_sparks": "bw_vv:redstone_sparks",
        "landed_effect": "bw_vv:smoke.mech.land",
        "destroy_effect": "bw_vv:metal_destroy"
      },
      "geometry": {
        "default": "geometry.bw_vv.mech"
      },
      "spawn_egg": {
        "texture": "bw_vv:vehicle_spawn",
        "texture_index": 0
      }
    }
  }
}
