			"minecraft:interact": {
				"interactions":	[
					// FUEL
					{
						
					"on_interact": {
						"filters": {
							"all_of": [
								{ "test": "has_equipment", "subject": "other", "domain": "hand", "value": "bw_vv:compressed_redstone"},
