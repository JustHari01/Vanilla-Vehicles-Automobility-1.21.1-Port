{
	"format_version": "1.21.120",
	"minecraft:entity": {
	"description": {
		"identifier": "bw_vv:plane",
		"is_spawnable": false,
		"is_summonable": true,
		"is_experimental": false,
		"animations": {
			//VEHICLE SPAWN (prevents spawn animation from repeating when world reloads or entity becomes invisible)
			"spawn_controller": "controller.animation.bw_vv.generic_vehicle_spawn",
			"spawn_timer": "animation.bw_vv.generic_vehicle_spawn_timer",
			//BOOST
			"boost_controller": "controller.animation.bw_vv.generic_vehicle_boost",
			"boost_timer":"animation.bw_vv.generic_vehicle_boost_timer",
			"boost_cooldown_timer":"animation.bw_vv.generic_vehicle_boost_cooldown_timer",
			"boost_sound": "animation.bw_vv.sound_boost",//running engine sound
			//ENGINE SOUND
			"engine_controller": "controller.animation.bw_vv.generic_vehicle_engine",
			"engine_standby": "animation.bw_vv.sound_engine_standby_minecar",
			"engine": "animation.bw_vv.sound_engine2",
			//FUEL
			"fuel_controller": "controller.animation.bw_vv.generic_vehicle_fuel",//activates the "fuel_decreaser" animation based on the movement speed of the vehicle.
			"fuel_activator_controller": "controller.animation.bw_vv.generic_vehicle_fuel_activator",//runs "event:fuel" or "event:unfuel" if the fuel_progress property is 0 or higher than 0.
			"fuel_decreaser": "animation.bw_vv.generic_vehicle_fuel_decreaser",//animation that slowly decreases the fuel over time based on a variable defined in the "variables" animation.bw_vv. This animation activates when the vehicle is fueled an moving.
			//CLIMB + PLAYER ANINMATION
			"climb_controller": "controller.animation.bw_vv.plane_climb",//controls the animations for when the vevhicle is moving up or down slopes, controls RP animations as well, used by the main.js script to send custom animations to the player riding the vehicle, so that the 2 entites are perfectly in sync.
			"climb_timer": "animation.bw_vv.generic_vehicle_climb_timer",//how much to wait before the animation can change
			//HIT
			"hit_controller": "controller.animation.bw_vv.generic_hit_timer",//a system controlling how much the player has to hit the vehicle in order for it to break (sensitive to specialized tools, in this case, picakaxes)
			"hit_timer": "animation.bw_vv.generic_hit_timer",//how quickly the hit state resets (hitting the vehicle 4 times takes only one more hit for it to break, waiting a certain time, stated in this animation, will reset the damaged state of the vehicle to 0)
			//VARIABLES
			"variables": "animation.bw_vv.plane_variables",//a list of vehicle variables, like resistance to hitting without the specialised tool, fuel efficiency & more
			//PLANE SPECIFIC ANIMATION CONTROLLERS
			"states_controller": "controller.animation.bw_vv.plane_states"
		  },
		  "scripts": {
			"animate": [
			  "variables",
			  "climb_controller", 
			  "boost_controller",
			  "engine_controller",
			  "fuel_controller",
			  "fuel_activator_controller",
			  "hit_controller",
			  "states_controller"
			 ]
		   },
		   "properties": {
			"bw_vv:spawned": { 
				"type": "bool", 
				"default": false,
				"client_sync": true 
			},
			"bw_vv:smoke_effect_size":{
			  "type": "float", 
			  "range": [0.0, 10.0], 
			  "default": 2.0,
			  "client_sync": true 
			},
			"bw_vv:player_anim_blend_time":{
				"type": "float",
				"range": [
					0.0,
					10.0
				],
				"default": 0.7,
				"client_sync": true
			},
			"bw_vv:fuel_progress": { 
			  "type": "float", 
			  "range": [0.0, 10.0], 
			  "default": 0.0,
			  "client_sync": true 
			},
			"bw_vv:hit_timer": { 
				"type": "int", 
				"range": [0, 5], 
				"default": 0,
				"client_sync": true 
			},
			"bw_vv:hit_sound": { 
				"type": "enum", 
				"values": ["normal", "final"], 
				"default": "normal", 
				"client_sync": true 
			},
			"bw_vv:hit_resistance": { 
				"type": "int", 
				"range": [0, 100], 
				"default": 40,
				"client_sync": true 
			},
			"bw_vv:hit_resistance_tools": { 
				"type": "int", 
				"range": [0, 20], 
				"default": 6,
				"client_sync": true 
			},
			"bw_vv:damage_progress": { 
			  "type": "int", 
			  "range": [0, 100], 
			  "default": 0,
			  "client_sync": true 
			},
			"bw_vv:damage_weak": { //whether the player is hitting the vehicle with their bare hand.
				"type": "bool", 
				"default": false,
				"client_sync": true 
			},
			"bw_vv:damage_anim": {  //L/R vehicle bobbing, for RP animations.
				"type": "enum", 
				"values": ["L", "R"], 
				"default": "R", 
				"client_sync": true 
			},
			"bw_vv:boost": { //whether the vehicle is boosted or not.
				"type": "enum", 
				"values": ["ready", "active", "cooldown"], 
				"default": "ready",
				"client_sync": true 
			},
			"bw_vv:boost_cooldown":{
				"type": "float", 
				"range": [0.0, 10.0], 
				"default": 0.0,
				"client_sync": true 
			},
			"bw_vv:lights": { //whether the lights function is active or not, based on the "dynamic lights" setting.
				"type": "bool", 
				"default": false,
				"client_sync": true 
			},
			"bw_vv:removed":{
				"type": "bool", 
				"default": false,
				"client_sync": true 
			},
			"bw_vv:wasd": { //what direction the vehicle is moving in. w = forward, s = backward, d = right & a = left.
				"type": "enum", 
				"values": ["w", "a", "s", "d"], 
				"default": "w", 
				"client_sync": true 
			},
			"bw_vv:player_anim": { //what animation will be sent to the RP and to the main.js script.
				"type": "enum", 
				"values": ["plane_flying", "climb_neutral", "plane_crashing"], 
				"default": "climb_neutral", 
				"client_sync": true 
			},
			"bw_vv:climb_animation": { // the inclination of the vehicle, used by the RP.
				"type": "float", 
				"range": [0.0, 50.0], 
				"default": 20.0,
				"client_sync": true 
			},
			"bw_vv:vertical_velocity": { // smoothed vertical velocity set by the main.js
				"type": "float", 
				"range": [-50.0, 50.0], 
				"default": 0.0,
				"client_sync": true 
			},
			//VEHICLE SPECIFIC PROPERTIES
			"bw_vv:plane_state": { //whether the vehicle is boosted or not.
				"type": "enum", 
				"values": ["takeoff", "flying", "stationary","crashing"], 
				"default": "stationary",
				"client_sync": true 
			},
			"bw_vv:level": { 
				"type": "int", 
				"range": [1, 3], 
				"default": 1,
				"client_sync": true 
			  },
			"bw_vv:plane_angle": { 
				"type": "float", 
				"range": [-90.00000, 90.00000], 
				"default": 0.00000,
				"client_sync": true 
			},
			//SMOKE BOMB
				"bw_vv:smoke_color": {
					"type": "enum",
					"values": [
						"white",
						"orange",
						"magenta",
						"light_blue",
						"yellow",
						"lime",
						"pink",
						"gray",
						"light_gray",
						"cyan",
						"purple",
						"blue",
						"brown",
						"green",
						"red",
						"black"
					],
					"default": "green",
					"client_sync": true
				},
				"bw_vv:smoke_bomb_cooldown":{
				"type": "bool", 
				"default": false,
				"client_sync": true 
			},
			//PLANE SPECIFIC PROPERTIES
				"bw_vv:trick": { // What wood variant this logcar is. Also dictates which logcar will drop when destroyed in survival.
					"type": "enum",
					"values": [
						"ready",
						"active",
						"cooldown"
					],
					"default": "ready",
					"client_sync": true
				},
				"bw_vv:wood_type": { // What wood variant this plane is. (future update)
					"type": "enum",
					"values": [
						"oak",
						"spruce",
						"birch",
						"jungle",
						"acacia",
						"dark_oak",
						"mangrove",
						"cherry",
						"bamboo",
						"crimson",
						"warped",
						"pale_oak"
					],
					"default": "oak",
					"client_sync": true
				}
		  }
		},
		"components": {
				"minecraft:pushable": { //Used to set that the vehicle is unpushable by other mobs.
					"is_pushable": true
				},
							"minecraft:color": {
				"value": 0
			},
				"minecraft:push_through": { //Also used to set that the vehicle is unpushable by other mobs.
					"value": 0.9
				},
			"minecraft:horse.jump_strength":{
				"value":0.0
			},
			"minecraft:can_power_jump":{
			},
