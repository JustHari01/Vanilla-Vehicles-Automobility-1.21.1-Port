							{ "test": "is_riding", "subject": "other", "operator": "==", "value": false },
							{ "test": "enum_property", "subject": "self", "domain": "bw_vv:hit_sound", "operator": "==", "value": "normal" },
							{ "test": "has_equipment", "subject": "other", "domain": "hand", "operator": "!=", "value": "stone_axe" },
							{ "test": "has_equipment", "subject": "other", "domain": "hand", "operator": "!=", "value": "wooden_axe" },
