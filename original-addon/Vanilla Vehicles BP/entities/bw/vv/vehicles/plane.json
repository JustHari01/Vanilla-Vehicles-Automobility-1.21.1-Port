									{ "test": "enum_property", "subject": "self", "domain": "bw_vv:trick", "operator": "==", "value": "ready" },
									{ "test": "enum_property", "subject": "self", "domain": "bw_vv:plane_state", "operator": "==", "value": "flying" }
