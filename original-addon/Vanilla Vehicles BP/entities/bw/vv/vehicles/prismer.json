{
	//this is the behavior file for the minecracar entity
	"format_version": "1.21.120",
	"minecraft:entity": {
		"description": {
			"identifier": "bw_vv:prismer",
			"is_spawnable": false,
			"is_summonable": true,
			"is_experimental": false,
			"animations": {
				//CLIMB + PLAYER ANINMATION
				"climb_controller": "controller.animation.bw_vv.prismer_climb", //controls the animations for when the vevhicle is moving up or down slopes, controls RP animations as well, used by the main.js script to send custom animations to the player riding the vehicle, so that the 2 entites are perfectly in sync.
				//HIT
				"hit_controller": "controller.animation.bw_vv.generic_hit_timer", //a system controlling how much the player has to hit the vehicle in order for it to break (sensitive to specialized tools, in this case, picakaxes)
				"hit_timer": "animation.bw_vv.generic_hit_timer", //how quickly the hit state resets (hitting the vehicle 4 times takes only one more hit for it to break, waiting a certain time, stated in this animation, will reset the damaged state of the vehicle to 0
				//VARIABLES
				"variables": "animation.bw_vv.prismer_variables" //a list of vehicle variables, like resistance to hitting without the specialised tool, fuel efficiency & more
			},
			"scripts": {
				"animate": [
					"variables",
					"climb_controller",
					"hit_controller"
				]
			},
			"properties": {
				"bw_vv:smoke_effect_size": {
					"type": "float",
					"range": [
						0.0,
						10.0
					],
					"default": 2.0,
					"client_sync": true
				},
				"bw_vv:fuel_progress": {
					"type": "float",
					"range": [
						0.0,
						10.0
					],
					"default": 0.0,
					"client_sync": true
				},
				"bw_vv:wasd": { //what direction the vehicle is moving in. w = forward, s = backward, d = right & a = left.
					"type": "enum",
					"values": [
						"w",
						"a",
						"s",
						"d"
					],
					"default": "w",
					"client_sync": true
				},
				"bw_vv:player_anim_blend_time": {
					"type": "float",
					"range": [
						0.0,
						10.0
					],
					"default": 0.1,
					"client_sync": true
				},
				"bw_vv:hit_timer": {
					"type": "int",
					"range": [
						0,
						5
					],
					"default": 0,
					"client_sync": true
				},
				"bw_vv:hit_sound": {
					"type": "enum",
					"values": [
						"normal",
						"final"
					],
					"default": "normal",
					"client_sync": true
				},
				"bw_vv:hit_resistance": {
					"type": "int",
					"range": [
						0,
						100
					],
					"default": 70,
					"client_sync": true
				},
				"bw_vv:hit_resistance_tools": {
					"type": "int",
					"range": [
						0,
						20
					],
					"default": 10,
					"client_sync": true
				},
				"bw_vv:damage_progress": {
					"type": "int",
					"range": [
						0,
						100
					],
					"default": 0,
					"client_sync": true
				},
				"bw_vv:damage_weak": { //whether the player is hitting the vehicle with their bare hand.
					"type": "bool",
					"default": false,
					"client_sync": true
				},
				"bw_vv:conduit_active": { //whether the player is hitting the vehicle with their bare hand.
					"type": "bool",
					"default": false,
					"client_sync": true
				},
				"bw_vv:damage_anim": { //L/R vehicle bobbing, for RP animations.
					"type": "enum",
					"values": [
						"L",
						"R"
					],
					"default": "R",
					"client_sync": true
				},
				"bw_vv:lights": { //whether the lights function is active or not, based on the "dynamic lights" setting.
					"type": "bool",
					"default": false,
					"client_sync": true
				},
				"bw_vv:removed": {
					"type": "bool",
					"default": false,
					"client_sync": true
				},
				"bw_vv:player_anim": { //what animation will be sent to the RP and to the main.js script.
					"type": "enum",
					"values": [
						"prismer_swimming",
						"climb_neutral"
					],
					"default": "climb_neutral",
					"client_sync": true
				},
				"bw_vv:climb_animation": { // the inclination of the vehicle, used by the RP.
					"type": "float",
					"range": [
						0.0,
						50.0
					],
					"default": 20.0,
					"client_sync": true
				},
				"bw_vv:vertical_velocity": { // smoothed vertical velocity set by the main.js
					"type": "float",
					"range": [
						-50.0,
						50.0
					],
					"default": 0.0,
					"client_sync": true
				}
			}
		},
		"components": {
			"minecraft:body_rotation_always_follows_head": {},
			"minecraft:collision_box": {
				"width": 1.2,
				"height": 1.0
			},
			"minecraft:is_collidable": {},
			"minecraft:movement": {
				"value": 0.20
			},
			"minecraft:health": {
				"value": 0.6
			},
			"minecraft:is_stackable": {},
			"minecraft:is_dyeable": {
				"interact_text": "bw_vv.action.interact.generic.spray"
			},
			"minecraft:color": {
				"value": 8
			},
			"minecraft:rideable": {
				"seat_count": 1,
				"family_types": [
					"player"
				],
				"crouching_skip_interact": true,
				"pull_in_entities": true,
				"rider_can_interact": false,
				"interact_text": "bw_vv.action.interact.generic.vehicle.enter",
				"controlling_seat": 0,
				"seats": [
					{
						"position": [
							0,
							0.0,
							-0.25
						]
					}
				]
			},
			"minecraft:fire_immune": {},
			"minecraft:knockback_resistance": { //Used to set that the vehicle is unpushable by other mobs.
				"value": 100
			},
			"minecraft:pushable": { //Used to set that the vehicle is unpushable by other mobs.
				"is_pushable": false
			},
			"minecraft:jump.static": {},
			"minecraft:underwater_movement": {
				"value": 0.14
			},
			"minecraft:push_through": { //Also used to set that the vehicle is unpushable by other mobs.
				"value": 1
			},
			"minecraft:type_family": {
				"family": [
					"vehicle",
					"minecar",
					"metal",
					"coal_based",
					"critical_hit",
					"bw_vanilla_vehicles"
				]
			},
			"minecraft:damage_sensor": {
				"triggers": [
				{
						"on_damage": {
							"filters":
							{
							"all_of": [
								{ "test": "is_family", "subject": "other", "operator": "==", "value": "player" },
								{ "test": "is_riding_self", "subject": "other", "operator": "==", "value": true }
								]
							}
						},
						"deals_damage": "no"
				},
				{
					"on_damage": {
						"filters":
						{
						"all_of": [
							{ "test": "is_family", "subject": "other", "operator": "==", "value": "player" },
							{ "test": "has_ability", "subject": "other", "operator": "!=", "value": "instabuild" },
							{ "test": "is_riding", "subject": "other", "operator": "==", "value": false },
							{ "test": "enum_property", "subject": "self", "domain": "bw_vv:hit_sound", "operator": "==", "value": "final" },
							{ "test": "has_equipment", "subject": "other", "domain": "hand", "operator": "!=", "value": "stone_pickaxe" },
							{ "test": "has_equipment", "subject": "other", "domain": "hand", "operator": "!=", "value": "wooden_pickaxe" },
							{ "test": "has_equipment", "subject": "other", "domain": "hand", "operator": "!=",  "value": "iron_pickaxe" },
							{ "test": "has_equipment", "subject": "other", "domain": "hand", "operator": "!=",  "value": "copper_pickaxe" },
							{ "test": "has_equipment", "subject": "other", "domain": "hand", "operator": "!=",  "value": "golden_pickaxe" },
							{ "test": "has_equipment", "subject": "other", "domain": "hand", "operator": "!=",  "value": "diamond_pickaxe" },
							{ "test": "has_equipment", "subject": "other", "domain": "hand", "operator": "!=",  "value": "netherite_pickaxe" }
							]
						},
						"event": "event:damager_weak",
						"target": "self"
					},
					"deals_damage": "no_but_side_effects_apply",
					"on_damage_sound_event": "death"
				},
				{
					"on_damage": {
						"filters":
						{
						"all_of": [
							{ "test": "is_family", "subject": "other", "operator": "==", "value": "player" },
							{ "test": "has_ability", "subject": "other", "operator": "!=", "value": "instabuild" },
							{ "test": "is_riding", "subject": "other", "operator": "==", "value": false },
							{ "test": "enum_property", "subject": "self", "domain": "bw_vv:hit_sound", "operator": "==", "value": "normal" },
							{ "test": "has_equipment", "subject": "other", "domain": "hand", "operator": "!=", "value": "stone_pickaxe" },
							{ "test": "has_equipment", "subject": "other", "domain": "hand", "operator": "!=", "value": "wooden_pickaxe" },
							{ "test": "has_equipment", "subject": "other", "domain": "hand", "operator": "!=",  "value": "iron_pickaxe" },
							{ "test": "has_equipment", "subject": "other", "domain": "hand", "operator": "!=",  "value": "copper_pickaxe" },
							{ "test": "has_equipment", "subject": "other", "domain": "hand", "operator": "!=",  "value": "golden_pickaxe" },
							{ "test": "has_equipment", "subject": "other", "domain": "hand", "operator": "!=",  "value": "diamond_pickaxe" },
							{ "test": "has_equipment", "subject": "other", "domain": "hand", "operator": "!=",  "value": "netherite_pickaxe" }
							]
						},
						"event": "event:damager_weak",
						"target": "self"
					},
					"deals_damage": "no_but_side_effects_apply",
					"on_damage_sound_event": "hurt"
				},
				{
					"on_damage": {
						"filters":
						{
							"all_of": [
								{ "test": "is_family", "subject": "other", "operator": "==", "value": "player" },
								{ "test": "has_ability", "subject": "other", "operator": "!=", "value": "instabuild" },
								{ "test": "is_riding", "subject": "other", "operator": "==", "value": false },
								{ "test": "enum_property", "subject": "self", "domain": "bw_vv:hit_sound", "operator": "==", "value": "normal" }
							  ],
						  "any_of": [
							{ "test": "has_equipment", "subject": "other", "domain": "hand", "value": "wooden_pickaxe" },
							{ "test": "has_equipment", "subject": "other", "domain": "hand", "value": "stone_pickaxe" },
							{ "test": "has_equipment", "subject": "other", "domain": "hand", "value": "iron_pickaxe" },
							{ "test": "has_equipment", "subject": "other", "domain": "hand", "value": "copper_pickaxe" },
							{ "test": "has_equipment", "subject": "other", "domain": "hand", "value": "golden_pickaxe" },
							{ "test": "has_equipment", "subject": "other", "domain": "hand", "value": "diamond_pickaxe" },
							{ "test": "has_equipment", "subject": "other", "domain": "hand", "value": "netherite_pickaxe" }
						  ]
						},
						"event": "event:damager",
						"target": "self"
					},
					"deals_damage": "no_but_side_effects_apply",
					"on_damage_sound_event": "hurt"
				},
				{
					"on_damage": {
						"filters":
						{
							"all_of": [
								{ "test": "is_family", "subject": "other", "operator": "==", "value": "player" },
								{ "test": "has_ability", "subject": "other", "operator": "!=", "value": "instabuild" },
								{ "test": "is_riding", "subject": "other", "operator": "==", "value": false },
								{ "test": "enum_property", "subject": "self", "domain": "bw_vv:hit_sound", "operator": "==", "value": "final" }
							  ],
								"any_of": [
									{ "test": "has_equipment", "subject": "other", "domain": "hand", "value": "wooden_pickaxe" },
									{ "test": "has_equipment", "subject": "other", "domain": "hand", "value": "stone_pickaxe" },
									{ "test": "has_equipment", "subject": "other", "domain": "hand", "value": "iron_pickaxe" },
									{ "test": "has_equipment", "subject": "other", "domain": "hand", "value": "copper_pickaxe" },
									{ "test": "has_equipment", "subject": "other", "domain": "hand", "value": "golden_pickaxe" },
									{ "test": "has_equipment", "subject": "other", "domain": "hand", "value": "diamond_pickaxe" },
									{ "test": "has_equipment", "subject": "other", "domain": "hand", "value": "netherite_pickaxe" }
								]
						},
						"event": "event:damager",
						"target": "self"
					},
					"deals_damage": "no_but_side_effects_apply",
					"on_damage_sound_event": "death"
				},
				{
					"on_damage": {
						"filters":
						{
						"all_of": [
							{ "test": "is_family", "subject": "other", "operator": "==", "value": "player" },
							{ "test": "has_ability", "subject": "other", "operator": "==", "value": "instabuild" }
						  ]
						},
						"event": "event:remove_creative"
					},
					"deals_damage": "no",
					"on_damage_sound_event": "death"
				},
				{
					"on_damage": {
						"filters":
						
							{}
						
					},
					"deals_damage": "no_but_side_effects_apply"
				}
			]
			},
			"minecraft:interact": {
				"interactions": [
					//CONDUIT INTERACTIONS / FUEL
					{
						"on_interact": {
							"filters": {
								"all_of": [
									{
										"any_of": [
											{
												"test": "has_equipment",
												"subject": "other",
												"domain": "hand",
												"value": "minecraft:conduit"
											}
										]
									},
									{
										"test": "in_water",
										"subject": "self"
									}
								]
							},
							"event": "event:fuel",
							"target": "self"
						},
						"swing": true,
						"use_item": true,
						"play_sounds": "conduit.activate",
						"interact_text": "bw_vv.action.interact.generic.fuel.add"
					}
				]
			}
		},
		"component_groups": {
			//Used to set the speed of the vehicle via "forward_limiter" animation_controller.
			"component_group:gravity": {
				"minecraft:physics": {
					"has_gravity": true
				}
			},
			//Used to stop the vehicle from being driven strictly to the right/ left, for realism.
			"component_group:no_gravity": {
				"minecraft:physics": {
					"has_gravity": false
				}
			},
			//The vv:removed component group is added when the vehicle is removed. It transforms into the bw_vv:break entity, which can be customized with particle effects.		
			"component_group:removed": {
				"minecraft:transformation": {
					"into": "bw_vv:break",
					"delay": 0.1,
					"drop_equipment": true,
					"drop_inventory": true
				}
			},
			"component_group:removed_creative": {
				"minecraft:transformation": {
					"into": "bw_vv:break",
					"delay": 0.1,
					"drop_equipment": false,
					"drop_inventory": true
				}
			},
			"component_group:fueled": {
				"minecraft:equipment": {
					"table": "loot_tables/bw/vv/conduit.json",
					"slot_drop_chance": [
						{
							"slot": "slot.weapon.mainhand",
							"drop_chance": 1
						}
					]
				},
				"minecraft:free_camera_controlled": {},
				"minecraft:variable_max_auto_step": {
					"base_value": 1.0625,
					"controlled_value": 1.0625,
					"jump_prevented_value": 0.5625
				}
			}
		},
		"events": {
			//EVENTS START
			"minecraft:entity_spawned": {
				"add": {
					"component_groups": [
						"component_group:gravity"
					]
				}
			},
			//FUEL EVENTS
			"event:fuel": {
				"add": {
					"component_groups": [
						"component_group:fueled",
						"component_group:no_gravity"
					]
				},
				"remove": {
					"component_groups": [
						"component_group:gravity"
					]
				},
				"set_property": {
					"bw_vv:conduit_active": true,
					"bw_vv:fuel_progress": "q.property('bw_vv:fuel_progress')+v.fuel_increaser"
				},
				"queue_command": {
					"command": "playsound vehicle.fuel_charge.conduit @p"
				}
			},
			"event:unfuel": {
				"remove": {
					"component_groups": [
						"component_group:fueled"
					]
				},
				"set_property": {
					"bw_vv:conduit_active": false
				},
				"queue_command": {
					"command": "playsound vehicle.fuel_discharge.conduit @p"
				}
			},
			// HIT EVENTS
			"event:damager":{
				"set_property": {
				    "bw_vv:hit_sound" : "q.property('bw_vv:damage_weak') == true ? ((q.property('bw_vv:damage_progress') == (q.property('bw_vv:hit_resistance')- 2)) ? 'final' : 'normal') : ((q.property('bw_vv:damage_progress') == (q.property('bw_vv:hit_resistance_tools') - 2)) ? 'final' : 'normal')",
					"bw_vv:hit_timer": 5,
					"bw_vv:damage_progress": "q.property('bw_vv:damage_weak') == true ? 1 : query.property('bw_vv:damage_progress') + 1",
					"bw_vv:damage_anim": "query.property('bw_vv:damage_anim') == 'R' ? 'L' : 'R'",
					"bw_vv:damage_weak": false
				}
			},
			"event:damager_weak":{
				"set_property": {
				    "bw_vv:hit_sound" : "q.property('bw_vv:damage_weak') == true ? ((q.property('bw_vv:damage_progress') == (q.property('bw_vv:hit_resistance')- 2)) ? 'final' : 'normal') : ((q.property('bw_vv:damage_progress') == (q.property('bw_vv:hit_resistance_tools') - 2)) ? 'final' : 'normal')",
					"bw_vv:hit_timer": 5,
					"bw_vv:damage_progress": "query.property('bw_vv:damage_progress') + 1",
					"bw_vv:damage_anim": "query.property('bw_vv:damage_anim') == 'R' ? 'L' : 'R'",
					"bw_vv:damage_weak": true
				}
			},
			"event:hit_timer_countdown":{
				"set_property": {
					"bw_vv:hit_timer": "math.clamp(query.property('bw_vv:hit_timer') - 1, 0, 10)"
				}
			},
			"event:remove": {
				"add": {
					"component_groups": [
						"component_group:removed"
					]
				},
				"queue_command":{
					"command":"loot spawn ~ ~ ~ loot \"bw/vv/vehicles/prismer\""
				},
				"set_property": {
					"bw_vv:removed": true
				}
			},
			"event:remove_creative": {
				"add": {
					"component_groups": [
						"component_group:removed_creative"
					]
				},
				"set_property": {
					"bw_vv:removed": true
				}
			},
			"event:remove_drop_items":{
				"add": {
					"component_groups": [
						"component_group:removed"
					]
				},
				"set_property": {
					"bw_vv:removed": true
				}
			},
			"event:remove_hits": {
				"set_property": {
					"bw_vv:damage_progress": 0,
					"bw_vv:damage_anim": "R",
					"bw_vv:damage_weak": false
				}
			},
			//LIGHTS EVENT
			"event.lights_on": {
				"set_property": {
					"bw_vv:lights": true
				}
			},
			"event.lights_off": {
				"set_property": {
					"bw_vv:lights": false
				}
			},
			//PLAYER ANIMATION EVENTS
			"event:player_anim_climb_neutral": {
				"set_property": {
					"bw_vv:player_anim": "climb_neutral"
				}
			},
			"event:player_anim_climb_swimming": {
				"set_property": {
					"bw_vv:player_anim": "prismer_swimming"
				}
			}
		}
	}
}