            }
          ]
        }
      },
      "component_group:has_envelope": {
        "minecraft:collision_box": {
          "height": 7.6,
          "width": 2.1
        },
        "minecraft:is_dyeable": {
          "interact_text": "bw_vv.action.interact.generic.spray"
        },
        "minecraft:interact": {
          "interactions": [
            {
              "on_interact": {
                "filters": {
                  "any_of": [
                    {
                      "test": "has_equipment",
                      "subject": "other",
                      "domain": "hand",
                      "value": "minecraft:shears"
                    }
                  ]
                },
                "event": "event:remove_envelope",
                "target": "self"
              },
              "swing": true,
              "use_item": false,
              "hurt_item": 1,
              "play_sounds": "shear",
              "vibration": "shear",
              "interact_text": "bw_vv.action.interact.hot_air_balloon.remove_envelope"
            },
            {
              "on_interact": {
                "filters": {
                  "all_of": [
                    {
                      "test": "has_equipment",
                      "subject": "other",
                      "domain": "hand",
                      "value": "minecraft:flint_and_steel"
                    },
                    {
                      "test": "float_property",
                      "subject": "self",
                      "domain": "bw_vv:fuel_progress",
                      "operator": "==",
                      "value": 0.0
                    }
                  ]
                },
                "event": "event:increment_fuel",
                "target": "self"
              },
              "swing": true,
              "hurt_item": 3,
              "use_item": false,
              "play_sounds": "ignite",
              "vibration": "shear",
              "interact_text": "bw_vv.action.interact.hot_air_balloon.ignite"
            },
            {
              "on_interact": {
                "filters": {
                  "all_of": [
                    {
                      "test": "has_equipment",
                      "subject": "other",
                      "domain": "hand",
                      "value": "minecraft:bundle"
                    },
                    {
                      "test": "bool_property",
                      "subject": "self",
                      "domain": "bw_vv:chested",
                      "value": false
                    }
                  ]
                },
                "event": "event:add_chest",
                "target": "self"
              },
              "swing": true,
              "use_item": true,
              "play_sounds": "armor.equip_generic",
              "interact_text": "bw_vv.action.interact.vehicle.add_bundle"
            },
            {
              "on_interact": {
                "filters": {
                  "all_of": [
                    {
                      "test": "bool_property",
                      "subject": "self",
                      "domain": "bw_vv:chested",
                      "value": false
                    },
                    {
                      "any_of": [
                        {
                          "test": "has_equipment",
                          "subject": "other",
                          "domain": "hand",
                          "value": "minecraft:black_bundle"
                        },
                        {
                          "test": "has_equipment",
                          "subject": "other",
                          "domain": "hand",
                          "value": "minecraft:blue_bundle"
                        },
                        {
                          "test": "has_equipment",
                          "subject": "other",
                          "domain": "hand",
                          "value": "minecraft:brown_bundle"
                        },
                        {
                          "test": "has_equipment",
                          "subject": "other",
                          "domain": "hand",
                          "value": "minecraft:cyan_bundle"
                        },
                        {
                          "test": "has_equipment",
                          "subject": "other",
                          "domain": "hand",
                          "value": "minecraft:gray_bundle"
                        },
                        {
                          "test": "has_equipment",
                          "subject": "other",
                          "domain": "hand",
                          "value": "minecraft:green_bundle"
                        },
                        {
                          "test": "has_equipment",
                          "subject": "other",
                          "domain": "hand",
                          "value": "minecraft:light_blue_bundle"
                        },
                        {
                          "test": "has_equipment",
                          "subject": "other",
                          "domain": "hand",
                          "value": "minecraft:light_gray_bundle"
                        },
                        {
                          "test": "has_equipment",
                          "subject": "other",
                          "domain": "hand",
                          "value": "minecraft:lime_bundle"
                        },
                        {
                          "test": "has_equipment",
                          "subject": "other",
                          "domain": "hand",
                          "value": "minecraft:magenta_bundle"
                        },
                        {
                          "test": "has_equipment",
                          "subject": "other",
                          "domain": "hand",
                          "value": "minecraft:orange_bundle"
                        },
                        {
                          "test": "has_equipment",
                          "subject": "other",
                          "domain": "hand",
                          "value": "minecraft:pink_bundle"
                        },
                        {
                          "test": "has_equipment",
                          "subject": "other",
                          "domain": "hand",
                          "value": "minecraft:purple_bundle"
                        },
                        {
                          "test": "has_equipment",
                          "subject": "other",
                          "domain": "hand",
