                          "subject": "other",
                          "domain": "hand",
                          "value": "minecraft:white_bundle"
                        },
                        {
                          "test": "has_equipment",
                          "subject": "other",
                          "domain": "hand",
                          "value": "minecraft:yellow_bundle"
                        }
                      ]
                    }
                  ]
                },
                "event": "event:bundle_warning",
                "target": "self"
              },
              "swing": true,
              "use_item": false,
              "interact_text": "bw_vv.action.interact.vehicle.add_bundle"
            }
          ]
        }
      },
      "component_group:removed": {
        "minecraft:transformation": {
          "into": "bw_vv:break",
          "delay": 0.2,
          "drop_equipment": true,
          "drop_inventory": true
        }
      },
      "component_group:removed_creative": {
        "minecraft:transformation": {
          "into": "bw_vv:break",
          "delay": 0.2,
          "drop_equipment": false,
          "drop_inventory": true
        }
      }
    },
    "events": {
      "minecraft:entity_spawned": {
        "add": {
          "component_groups": [
            "component_group:no_envelope",
            "component_group:ground_mode"
          ]
        }
      },
      "event:add_chest": {
        "set_property": {
          "bw_vv:chested": true
        },
        "add": {
          "component_groups": ["component_group:chested"]
        }
      },
      "event:bundle_warning": {
        "queue_command": {
          "command": "execute as @p at @s run scriptevent bw_vv:bundle_warning"
        }
      },
      "event:heat": {
        "set_property": {
          "bw_vv:heated": true
        }
      },
      "event:enter_flight_mode": {
        "add": {
          "component_groups": ["component_group:flight_mode"]
        },
        "remove": {
          "component_groups": ["component_group:ground_mode"]
        }
      },
      "event:enter_ground_mode": {
        "add": {
          "component_groups": ["component_group:ground_mode"]
        },
        "remove": {
          "component_groups": ["component_group:flight_mode"]
        }
      },
      "event:add_envelope.blank": {
        "add": {
          "component_groups": [
            "component_group:envelope.blank",
            "component_group:has_envelope"
          ]
        },
        "remove": {
          "component_groups": ["component_group:no_envelope"]
        },
        "set_property": {
          "bw_vv:envelope_type": "blank"
        }
      },
      "event:add_envelope.striped": {
        "add": {
          "component_groups": [
            "component_group:envelope.striped",
            "component_group:has_envelope"
          ]
        },
        "remove": {
          "component_groups": ["component_group:no_envelope"]
        },
        "set_property": {
          "bw_vv:envelope_type": "striped"
        }
      },
      "event:add_envelope.creeper": {
        "add": {
          "component_groups": [
            "component_group:envelope.creeper",
            "component_group:has_envelope"
          ]
        },
        "remove": {
          "component_groups": ["component_group:no_envelope"]
        },
        "set_property": {
          "bw_vv:envelope_type": "creeper"
        }
      },

      "event:remove_envelope": {
        "add": {
          "component_groups": ["component_group:no_envelope"]
        },
        "remove": {
          "component_groups": [
            "component_group:envelope.blank",
            "component_group:envelope.creeper",
            "component_group:envelope.striped"
          ]
        },
        "trigger": "event:empty_fuel",
        "set_property": {
          "bw_vv:envelope_type": "empty"
        },
        "drop_item": { "slot": "slot.weapon.mainhand" }
      },
      //HIT EVENTS
      "event:damager": {
        "set_property": {
          "bw_vv:hit_sound": "q.property('bw_vv:damage_weak') == true ? ((q.property('bw_vv:damage_progress') == (q.property('bw_vv:hit_resistance')- 2)) ? 'final' : 'normal') : ((q.property('bw_vv:damage_progress') == (q.property('bw_vv:hit_resistance_tools') - 2)) ? 'final' : 'normal')",
          "bw_vv:hit_timer": 5,
          "bw_vv:damage_progress": "q.property('bw_vv:damage_weak') == true ? 1 : query.property('bw_vv:damage_progress') + 1",
          "bw_vv:damage_anim": "query.property('bw_vv:damage_anim') == 'R' ? 'L' : 'R'",
          "bw_vv:damage_weak": false //s
        }
      },
      "event:damager_weak": {
        "set_property": {
          "bw_vv:hit_sound": "q.property('bw_vv:damage_weak') == true ? ((q.property('bw_vv:damage_progress') == (q.property('bw_vv:hit_resistance')- 2)) ? 'final' : 'normal') : ((q.property('bw_vv:damage_progress') == (q.property('bw_vv:hit_resistance_tools') - 2)) ? 'final' : 'normal')",
          "bw_vv:hit_timer": 5,
          "bw_vv:damage_progress": "query.property('bw_vv:damage_progress') + 1",
          "bw_vv:damage_anim": "query.property('bw_vv:damage_anim') == 'R' ? 'L' : 'R'",
          "bw_vv:damage_weak": true
        }
      },
      "event:hit_timer_countdown": {
        "set_property": {
          "bw_vv:hit_timer": "math.clamp(query.property('bw_vv:hit_timer') - 1, 0, 10)"
        }
      },
      "event:remove": {
        "sequence": [
          {
            "filters": {
              "test": "bool_property",
              "subject": "self",
              "domain": "bw_vv:chested",
              "value": true
            },
            "queue_command": {
              "command": "loot spawn ~ ~ ~ loot \"bw/vv/bundle\""
            }
          },
          {
            "add": {
              "component_groups": ["component_group:removed"]
            },
            "queue_command": {
              "command": [
                "loot spawn ~ ~ ~ loot \"bw/vv/vehicles/hot_air_balloon/basket\"",
                "scriptevent bw_vv:spawn_dye"
              ]
            },
            "set_property": {
              "bw_vv:removed": true
            }
          }
        ]
      },
      "event:remove_creative": {
        "add": {
          "component_groups": ["component_group:removed_creative"]
        },
        "set_property": {
          "bw_vv:removed": true
        }
      },
      "event:remove_drop_items": {
        "add": {
          "component_groups": ["component_group:removed"]
        },
        "set_property": {
          "bw_vv:removed": true
        },
        "queue_command": {
          "command": "loot spawn ~ ~ ~ loot \"bw/vv/vehicles/hot_air_balloon/basket\""
        }
      },
      "event:remove_hits": {
        "set_property": {
          "bw_vv:damage_progress": 0,
          "bw_vv:damage_anim": "R",
          "bw_vv:damage_weak": false
        }
      },
      //FUEL EVENTS
      "event:increment_fuel": {
        "set_property": {
          "bw_vv:fuel_progress": "query.property('bw_vv:fuel_progress') + v.fuel_increaser"
        },
        "queue_command": {
          "command": "playsound vehicle.fuel_up.redstone @p" //sound for fuelling up the tank
        }
      },
      "event:decrement_fuel": {
        "set_property": {
          "bw_vv:fuel_progress": "query.property('bw_vv:fuel_progress') - v.fuel_efficiency"
        }
      },
      "event:empty_fuel": {
        "set_property": {
          "bw_vv:fuel_progress": 0
        }
      },
      "event:fuel": {
        "add": {
          "component_groups": ["component_group:fueled"]
        }
      },
      "event:unfuel": {
        "remove": {
          "component_groups": ["component_group:fueled"]
        },
        "queue_command": {
          "command": "playsound vehicle.fuel_discharge.redstone @p" //sound for when the fuel runs out
        }
      }
    }
  }
}
