		"weapons_controller": "controller.animation.bw_vv.mech_weapons",
		"weapons_cooldown_timer": "animation.bw_vv.mech_weapons_cooldown_timer",
		"weapons_timer": "animation.bw_vv.generic_vehicle_weapons_timer",
		//HIT
