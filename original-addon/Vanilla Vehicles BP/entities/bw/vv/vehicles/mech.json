		"player_anim_wasd_updater": "controller.animation.bw_vv.mech_player_anim_wasd",
		"player_anim_timer": "animation.bw_vv.mech_walk_anim_timer", // Equivalent to walk_anim_timer from the resource pack side.
		"player_anim_delay": "animation.bw_vv.player_mech_anim_delay",
		//VARIABLES
		"variables": "animation.bw_vv.mech_variables"
      },
      "scripts": {
        "animate": [
		  "variables",
		  "player_anim_updater",
	      "spawn_controller",
		  "weapons_controller",
		  "hit_controller",
		  "boost_controller"
		 ]
       },
	   "properties": {
		"bw_vv:spawned": { 
			"type": "bool", 
