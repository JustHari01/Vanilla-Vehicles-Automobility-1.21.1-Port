{
    "format_version": "1.10.0",
    "animation_controllers": {
      "controller.animation.bw_vv.generic_vehicle_spawn": {
        "states": {
          "default": {
            "transitions": [
              {
                "spawned": "q.all_animations_finished"
              }
            ],
            "animations": [
              "spawn_timer"
            ]
          },
          "spawned": {
            "on_entry": [
              "@s event:spawn"
            ]
          }
        }
      }
    }
  }