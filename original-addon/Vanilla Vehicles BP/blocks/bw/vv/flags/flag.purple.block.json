{
	"format_version": "1.21.100",
	"minecraft:block": {
		"description": {
			"identifier": "bw_vv:flag.purple",
			"states": {
                "bw_vv:wind_dir": ["N", "E", "S", "W"]
}
		},
		"components": {
			"minecraft:collision_box": {
				"origin": [-1, 0, -1],
				"size": [2, 16, 2]
			},
			"tag:bw_vv:flag.pole": {},
			"minecraft:placement_filter": { 
                "conditions": [
                    {
                        "allowed_faces": [ // Decides in which faces the torch can be placed.
                            "up"
                        ],
                        "block_filter": [
                            {
                                "tags": "q.any_tag('grass','stone','wood','bw_vv:flag.pole','minecraft:is_pickaxe_item_destructible','sand')" // Allowed blocks to place the torch at.
                            }
                        ]
                    }
                ]
            },
			"minecraft:selection_box": {
				"origin": [-2, 0, -2],
				"size": [4, 16, 4]
			},
			"minecraft:destructible_by_mining": {
				"seconds_to_destroy": 1
			},
			"minecraft:destructible_by_explosion": {
				"explosion_resistance": 14
			},
			"minecraft:flammable": {
				"destroy_chance_modifier": 20,
				"catch_chance_modifier": 5
			},
			"minecraft:geometry": "geometry.bw_vv.flag",
			"minecraft:material_instances": {
				"*": {
					"texture": "bw_vv:flag_purple",
					"render_method": "alpha_test",
					"ambient_occlusion": false
				}
			},
			"minecraft:light_dampening": 1,
			"minecraft:map_color": "#8932b8",
			"tag:minecraft:is_axe_item_destructible": {},
			"minecraft:liquid_detection": {
				"detection_rules": [
					{
						"liquid_type": "water",
						"on_liquid_touches": "no_reaction"
					}
				]
			}
		},
		"permutations": [
		{
			"condition": "q.block_state('bw_vv:wind_dir') == 'N'",
			"components": {
			"minecraft:transformation": { "rotation": [0, 180, 0] }
			}
		},
		{
			"condition": "q.block_state('bw_vv:wind_dir') == 'E'",
			"components": {
			"minecraft:transformation": { "rotation": [0, 270, 0] }
			}
		},
		{
			"condition": "q.block_state('bw_vv:wind_dir') == 'S'",
			"components": {
			"minecraft:transformation": { "rotation": [0, 0, 0] }
			}
		},
		{
			"condition": "q.block_state('bw_vv:wind_dir') == 'W'",
			"components": {
			"minecraft:transformation": { "rotation": [0, 90, 0] }
			}
		}
	  ]
	}
}
